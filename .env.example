# Copy this file to ".env" and fill in your key, then:  source .env
# (or set these variables however your host expects)

# Your Anthropic API key — get one at https://console.anthropic.com
# Without it the app still runs, but the narrative sections use a plain template.
export ANTHROPIC_API_KEY=sk-ant-...

# Which model writes the interpretation. Any current model you have access to.
# See https://docs.claude.com/en/docs/about-claude/models
export JYOTISH_MODEL=claude-sonnet-5
